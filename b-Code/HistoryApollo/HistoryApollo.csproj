<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="HistoryApolloVersion.props" />

  <PropertyGroup>
    <!--
      net8.0 而不是 net8.0-windows：本模块只有 HttpClient 与 JSON，没有窗口、
      没有 Win32 依赖，因此装载上下文能真正卸载，改它不必停宿主。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>HistoryApollo</AssemblyName>
    <RootNamespace>HistoryApollo</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

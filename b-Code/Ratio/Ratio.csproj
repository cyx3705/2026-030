<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="RatioVersion.props" />

  <PropertyGroup>
    <!--
      保留 net8.0 以兼容宿主与离线测试；原生本机后端显式检查 Windows x64，
      卸载先停止推理并等待回调退出，未停稳时保留原生 DLL 映射。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Ratio</AssemblyName>
    <RootNamespace>Ratio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.7.0：本机推理服务源码随 DLL 发布，ratio.local.start 原样部署到运行区（ServiceBundle）。
         资源名 service/<相对路径>，分隔符在 ServiceBundle 里统一成正斜杠。 -->
    <EmbeddedResource Include="..\..\b-Code-Service\**\*"
                      Exclude="..\..\b-Code-Service\**\__pycache__\**;..\..\b-Code-Service\*.md"
                      LogicalName="service/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Build-native.ps1 produces this directory outside the repository. Native
       libraries are embedded, then materialized by ServiceBundle; the host's
       byte-loaded module does not need a native DLL in its package load slot. -->
  <PropertyGroup>
    <RatioNativeRoot Condition="'$(RatioNativeRoot)' == ''">$(RATIO_NATIVE_ROOT)</RatioNativeRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(RatioNativeRoot)' != ''">
    <EmbeddedResource Include="$(RatioNativeRoot)\*.dll" LogicalName="service/native/bin/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ValidateNativeRuntime" BeforeTargets="BeforeBuild" Condition="'$(RequireNativeRuntime)' == 'true'">
    <Error Condition="!Exists('$(RatioNativeRoot)\ratio-inference.dll')" Text="Native runtime missing: build-native.ps1 first; set RatioNativeRoot or RATIO_NATIVE_ROOT." />
  </Target>
</Project>

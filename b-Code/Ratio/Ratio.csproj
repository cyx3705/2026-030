<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="RatioVersion.props" />

  <PropertyGroup>
    <!--
      net8.0 而不是 net8.0-windows：本模块只有 HttpClient 与 JSON，没有窗口、
      没有 Win32 依赖，因此装载上下文能真正卸载，改它不必停宿主。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Ratio</AssemblyName>
    <RootNamespace>Ratio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.7.0：本机推理服务源码随 DLL 发布，ratio.local.start 原样部署到运行区（ServiceBundle）。
         资源名 service/<相对路径>，分隔符在 ServiceBundle 里统一成正斜杠。 -->
    <EmbeddedResource Include="..\..\b-Code-Service\**\*"
                      Exclude="..\..\b-Code-Service\**\__pycache__\**;..\..\b-Code-Service\*.md"
                      LogicalName="service/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

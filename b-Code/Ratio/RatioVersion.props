<Project>
  <PropertyGroup>
    <!-- 版本的唯一真源。module.manifest.json 与根 project.manifest.json 必须同值，
         打包脚本会逐一比对，不一致直接失败——宿主对版本不一致的处理是静默跳过整个模块。 -->
    <RatioVersion>0.9.0</RatioVersion>
    <!-- Ratio 消费的 HistoryVulcan 正式宿主版本。5.1.2 起模块接入面冻结为
         注册器 + 命令总线，本模块只用这两样。 -->
    <MinimumHistoryVulcanVersion>6.0.0</MinimumHistoryVulcanVersion>
    <VersionPrefix>$(RatioVersion)</VersionPrefix>
    <Version>$(RatioVersion)</Version>
    <AssemblyVersion>$(RatioVersion).0</AssemblyVersion>
    <FileVersion>$(RatioVersion).0</FileVersion>
    <InformationalVersion>$(RatioVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
